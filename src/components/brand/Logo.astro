---
interface Props {
  href?: string;
  label?: string;
  markShadow?: boolean;
  variant?: "dark" | "light";
  ariaCurrent?: "page" | undefined;
  active?: boolean;
  dataSiteBrand?: boolean;
}

const {
  href = "/",
  label = "4all.tools home",
  markShadow = true,
  variant = "dark",
  ariaCurrent,
  active = false,
  dataSiteBrand = false,
} = Astro.props;

const variantStyles = {
  dark: {
    text: "text-slate-900",
    accent: "text-blue-400",
    mark: "bg-slate-900",
    markCell: "bg-white",
    markAccent: "bg-blue-400",
    shadow: "shadow-[0_5px_14px_#2563eb40]",
  },
  light: {
    text: "text-white",
    accent: "text-blue-300",
    mark: "bg-white",
    markCell: "bg-slate-900",
    markAccent: "bg-blue-500",
    shadow: "shadow-[0_5px_14px_#60a5fa66]",
  },
} satisfies Record<
  NonNullable<Props["variant"]>,
  {
    text: string;
    accent: string;
    mark: string;
    markCell: string;
    markAccent: string;
    shadow: string;
  }
>;

const styles = variantStyles[variant];
---

<a
  class:list={[
    "inline-flex items-center gap-2.5 font-[Inter,ui-sans-serif,system-ui,sans-serif] text-xl leading-[1.6] font-extrabold tracking-[-0.7px] no-underline antialiased focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-blue-600/35",
    styles.text,
  ]}
  href={href}
  aria-label={label}
  aria-current={ariaCurrent}
  data-site-brand={dataSiteBrand ? true : undefined}
  data-site-logo={dataSiteBrand ? true : undefined}
  data-active={active ? "true" : undefined}
>
  <span
    class:list={[
      "grid size-7 grid-cols-2 gap-0.5 rounded-lg p-[5px]",
      styles.mark,
      markShadow && styles.shadow,
    ]}
    aria-hidden="true"
  >
    <span class:list={["rounded-[1.5px] opacity-95", styles.markCell]}></span>
    <span class:list={["rounded-[1.5px] opacity-95", styles.markCell]}></span>
    <span class:list={["rounded-[1.5px] opacity-95", styles.markCell]}></span>
    <span class:list={["rounded-[1.5px] opacity-95", styles.markAccent]}></span>
  </span>
  <span>4all<span class={styles.accent}>.tools</span></span>
</a>
