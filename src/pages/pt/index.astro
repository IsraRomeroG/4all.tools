---
import HomeTemplate from '@/templates/HomeTemplate.astro';
import { composeHomePageModel } from '@/templates/composers/home';
import { getDeliveryRouteRegistry } from '@/templates/composers';

const locale = 'pt' as const;
const page = await composeHomePageModel(locale, {
  routeRegistry: await getDeliveryRouteRegistry(),
});
---

<HomeTemplate page={page} />
